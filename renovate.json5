{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:openssf-scorecard",
    ":assignee(ollecoffee)",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":labels(dependencies)",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":separateMultipleMajorReleases",
    ":separatePatchReleases",
  ],
  packageRules: [
    {
      // Gate on the datasource, not the manager: these repos have moved between bun,
      // deno and pnpm, and the supply-chain buffer should survive the next move.
      matchDatasources: ["npm"],
      minimumReleaseAge: "2 days",
      internalChecksFilter: "strict",
    },
    {
      // Renovate has no single release to age for lockFileMaintenance, so the rule
      // above leaves renovate/stability-days pending forever and blocks automerge.
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: "0 days",
      internalChecksFilter: "none",
      automerge: true,
    },
  ],
  lockFileMaintenance: {
    schedule: ["before 9am on monday"],
  },
}
